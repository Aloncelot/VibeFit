# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local al repositorio.

# Azure SQL
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
AZURE_SQL_PORT=1433

# Acceso al panel /admin
ADMIN_PASSWORD=
# Clave para firmar la cookie de sesión (mínimo 32 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Cloudinary (solo scripts de migración)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Azure AI Vision (OCR de etiquetas)
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=

# Correo (opcional) con Resend: avisos al admin por solicitudes y reseñas nuevas
RESEND_API_KEY=
EMAIL_FROM="VIBEFIT <avisos@tudominio.com>"
ADMIN_EMAIL=

# Pagos en línea (false = carrito muestra "Próximamente"; el servidor rechaza pedidos)
NEXT_PUBLIC_PAGOS_ACTIVOS=false
